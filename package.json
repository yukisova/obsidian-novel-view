{
  "name": "novelview",
  "version": "0.13.5",
  "description": "Novel writing workflow with chapter statuses, materials/link libraries, link-library keywords, and find/replace.",
  "main": "main.js",
  "scripts": {
    "dev": "npm run styles && node esbuild.config.mjs --watch",
    "build": "npm run build:only && node scripts/deploy.mjs",
    "build:only": "npm run styles && tsc --noEmit && node esbuild.config.mjs production",
    "deploy": "node scripts/deploy.mjs",
    "check": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "styles": "node scripts/build-styles.mjs",
    "styles:watch": "sass --watch styles.sass styles.css"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "markdown",
    "novel",
    "writing"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "obsidian": "^1.14.4",
    "sass": "^1.108.2",
    "typescript": "^5.9.3"
  },
  "author": "yukisova",
  "dependencies": {
    "@codemirror/commands": "^6.11.1"
  }
}
