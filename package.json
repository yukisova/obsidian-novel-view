{
  "name": "novelview",
  "version": "0.3.6",
  "description": "Obsidian novel workflow: auto mode, inline article rename, outline slides, inspiration cards, special pages, and find/replace.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
